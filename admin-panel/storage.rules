rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return signedIn() && currentUser().role == 'super_admin';
    }

    function isTeamMember(teamId) {
      return signedIn() && currentUser().teamId == teamId;
    }

    function isTeamAdmin(teamId) {
      return isSuperAdmin() || (
        isTeamMember(teamId) &&
        currentUser().role in ['owner', 'admin']
      );
    }

    function profileData(profileId) {
      return firestore.get(/databases/(default)/documents/profiles/$(profileId)).data;
    }

    function canUseProfile(profileId) {
      let profile = profileData(profileId);
      return isSuperAdmin() || (
        isTeamMember(profile.teamId) &&
        (
          currentUser().role in ['owner', 'admin'] ||
          (
            currentUser().role == 'va' &&
            currentUser().assignedFolderId != null &&
            currentUser().assignedFolderId == profile.folderId
          )
        )
      );
    }

    match /extensions/{teamId}/{allPaths=**} {
      allow read: if isSuperAdmin() || isTeamMember(teamId);
      allow write: if isTeamAdmin(teamId) &&
        request.resource.size < 100 * 1024 * 1024;
    }

    match /extensions/{fileName} {
      allow read, write: if isSuperAdmin();
    }

    match /profiles/{profileId}/{allPaths=**} {
      allow read, write: if canUseProfile(profileId) &&
        (request.resource == null || request.resource.size < 250 * 1024 * 1024);
    }
  }
}
